{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firetree.local/schemas/assessment.schema.json",
  "title": "FireTree assessment v0",
  "description": "The change-entry artifact: automatic and final tier, impact set, required artifacts, sampling decision, sign-off requirement, and policy version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "tier",
    "auto_tier",
    "reasons",
    "impact",
    "confidence",
    "required_artifacts",
    "sampling",
    "signoff_required",
    "policy",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "firetree.assessment/v0" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base", "head", "files"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "base": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tier": { "type": "string", "enum": ["L0", "L1", "L2"] },
    "auto_tier": { "type": "string", "enum": ["L0", "L1", "L2"] },
    "declared_tier": { "type": "string", "enum": ["L0", "L1", "L2"] },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "subsystems", "interfaces", "owners", "tests", "unknown", "unresolved_consumers", "traversed"],
      "properties": {
        "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "subsystems": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "interfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "owners": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "tests": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "unknown": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "unresolved_consumers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "traversed": { "type": "boolean" }
      }
    },
    "confidence": { "type": "string", "enum": ["high", "low"] },
    "required_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "rate", "selected", "method"],
      "properties": {
        "tier": { "type": "string", "enum": ["L0", "L1", "L2"] },
        "rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "selected": { "type": "boolean" },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "signoff_required": { "type": "string", "enum": ["none", "peer", "human"] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
