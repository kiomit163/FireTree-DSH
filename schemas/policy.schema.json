{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firetree.local/schemas/policy.schema.json",
  "title": "FireTree policy v0",
  "description": "Repository policy: tier rules, sampling, time-boxed exceptions, and tighten-only inheritance. Child layers may tighten policy; relaxation is only through an exception with an architect approval and an expiry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "scope",
    "extends",
    "tiers",
    "triggers",
    "sampling",
    "exceptions",
    "inheritance"
  ],
  "properties": {
    "schema": {
      "const": "firetree.policy/v0"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Content hash of this policy document."
    },
    "scope": {
      "type": "string",
      "enum": ["org", "repo", "subsystem"]
    },
    "extends": {
      "description": "Parent policy reference; null only for the org layer.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L0", "L1", "L2"],
      "properties": {
        "L0": { "$ref": "#/$defs/tierPolicy" },
        "L1": { "$ref": "#/$defs/tierPolicy" },
        "L2": { "$ref": "#/$defs/tierPolicy" }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L0", "L1", "L2"],
      "properties": {
        "L0": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "L1": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "L2": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "record_required"],
      "properties": {
        "mode": { "const": "tiered" },
        "record_required": { "const": true }
      }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "inheritance": {
      "$ref": "#/$defs/inheritance"
    }
  },
  "$defs": {
    "tierPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate",
        "review_rounds",
        "signoff",
        "correctness_case",
        "token_budget"
      ],
      "properties": {
        "sample_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "signoff": {
          "type": "string",
          "enum": ["none", "peer", "human"]
        },
        "correctness_case": {
          "type": "string",
          "enum": ["none", "light", "full"]
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "approver",
        "scope",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EX-[0-9]{3,}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approver": {
          "type": "string",
          "pattern": "^human:",
          "description": "Exceptions require a named human approver, never an agent."
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "Path glob or change id this exception covers."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Expired exceptions automatically stop applying."
        }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "relaxation_via", "relaxation_requires"],
      "properties": {
        "mode": {
          "const": "tighten_only"
        },
        "relaxation_via": {
          "const": "exception"
        },
        "relaxation_requires": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["architect_approval", "expires_at"]
          }
        }
      }
    }
  }
}
