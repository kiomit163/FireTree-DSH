{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firetree.local/schemas/receipt.schema.json",
  "title": "FireTree delivery receipt v1",
  "description": "The auditable exit artifact for one change. It references external evidence; it never creates evidence. The full correctness-case file validates against #/$defs/correctnessCase. Empty mapping is a semantic rejection implemented by the v1 correctness-case checker, because JSON Schema cannot compare claim ids across arrays.",
  "$comment": "M0 v1 contract. Full cross-field verification (claim coverage, last-round zero findings, residual expiry, local A1 provenance) belongs to M2; the schema already exposes every field those checks need.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "tier",
    "policy",
    "hypotheses",
    "evidence",
    "review",
    "correctness_case",
    "impact",
    "signoff",
    "expires_at",
    "assurance"
  ],
  "properties": {
    "schema": {
      "const": "firetree.receipt/v1"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "files_sha256"],
      "properties": {
        "base": { "$ref": "#/$defs/commit" },
        "head": { "$ref": "#/$defs/commit" },
        "tree_sha": { "$ref": "#/$defs/commit" },
        "diff_sha256": { "$ref": "#/$defs/sha256" },
        "files_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tier": {
      "type": "string",
      "enum": ["L0", "L1", "L2"]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sampling"],
      "properties": {
        "version": { "$ref": "#/$defs/sha256" },
        "sampling": {
          "type": "string",
          "enum": ["none", "sampled", "full"]
        },
        "sample": { "$ref": "#/$defs/sampleRecord" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "sha256"],
      "properties": {
        "spec": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subsystem", "kind", "method", "dossier_sha256"],
      "properties": {
        "subsystem": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["simple", "large", "simple-giant", "open-complex-giant", "unknown"]
        },
        "method": {
          "type": "string",
          "enum": ["decompose", "metasynthesis"]
        },
        "dossier_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "hypotheses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "verified", "accepted_risk"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "accepted_risk": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "review": {
      "description": "Review summary. null only for an unsampled L0; L1/L2 require an object; sampled L0 requires a human spot-check.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/reviewSummary" }
      ]
    },
    "correctness_case": {
      "description": "Summary of the separate correctness-case file. null for L0; required object for L2.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/correctnessCaseSummary" }
      ]
    },
    "synthesis": {
      "description": "M2 linkage to the L2 synthesis plan and final converged round; required for L2.",
      "$ref": "#/$defs/synthesisSummary"
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "subsystems",
        "interfaces",
        "owners",
        "unknown",
        "unresolved_consumers",
        "reasons",
        "traversed",
        "confidence"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "subsystems": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "interfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "owners": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unknown": {
          "description": "Changed paths that no registered subsystem matched. L2 may have an empty subsystem set only when this is non-empty.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unresolved_consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "traversed": {
          "type": "boolean"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "low"]
        }
      }
    },
    "signoff": {
      "description": "Human or CI sign-off. L2 must be human.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/signoff" }
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "assurance": {
      "type": "string",
      "enum": ["A1", "A2", "A3"],
      "description": "A1 local-only; A2 CI OIDC-verified; A3 A2 plus verified human approval and a signed/attested bundle. Derived by the verifier, never taken from the caller."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": { "const": "L2" }
        },
        "required": ["tier"]
      },
      "then": {
        "properties": {
          "correctness_case": { "type": "object" },
          "synthesis": { "type": "object" },
          "signoff": {
            "type": "object",
            "required": ["by", "identity", "at", "scope"],
            "properties": {
              "by": { "const": "human" }
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "mode": { "const": "full" },
              "rounds": { "minimum": 2 },
              "new_findings": { "minItems": 2 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "kind": {
                "enum": ["open-complex-giant", "unknown"]
              }
            },
            "required": ["kind"]
          }
        },
        "required": ["classification"]
      },
      "then": {
        "properties": {
          "tier": { "const": "L2" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "properties": {
              "sampling": { "const": "sampled" }
            },
            "required": ["sampling"]
          }
        },
        "required": ["policy"]
      },
      "then": {
        "properties": {
          "policy": {
            "required": ["sample"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": { "enum": ["L0", "L1"] }
        },
        "required": ["tier"]
      },
      "then": {
        "properties": {
          "impact": {
            "properties": {
              "traversed": { "const": true },
              "confidence": { "const": "high" },
              "subsystems": { "minItems": 1 },
              "owners": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": { "const": "L1" }
        },
        "required": ["tier"]
      },
      "then": {
        "properties": {
          "review": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": { "const": "standard" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": { "const": "L0" },
          "policy": {
            "properties": {
              "sampling": { "const": "sampled" }
            },
            "required": ["sampling"]
          }
        },
        "required": ["tier", "policy"]
      },
      "then": {
        "properties": {
          "review": {
            "type": "object",
            "required": ["mode", "human_spot_check"],
            "properties": {
              "mode": { "const": "light" },
              "human_spot_check": { "$ref": "#/$defs/humanSpotCheck" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assurance": { "const": "A2" }
        },
        "required": ["assurance"]
      },
      "then": {
        "properties": {
          "evidence": {
            "items": {
              "properties": {
                "producer": { "pattern": "^(?!local:).+" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "dissent": { "const": 0 }
            },
            "required": ["dissent"]
          }
        },
        "required": ["review"]
      },
      "then": {
        "properties": {
          "review": {
            "required": ["zero_dissent_checks"],
            "properties": {
              "zero_dissent_checks": { "minItems": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "synthesisSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "rounds", "last_round", "converged"],
      "properties": {
        "plan": { "$ref": "#/$defs/artifactRef" },
        "rounds": { "type": "integer", "minimum": 1 },
        "last_round": { "$ref": "#/$defs/artifactRef" },
        "converged": { "type": "boolean", "const": true }
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "sampleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decided_by", "decided_at", "conclusion"],
      "properties": {
        "decided_by": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "conclusion": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "producer",
        "run_ref",
        "sha256",
        "produced_at"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["test", "coverage", "sarif", "sbom", "bench", "analysis"]
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!agent(?:$|[:/])).+$",
          "description": "CI or deterministic tool. The agent is never an evidence producer; local:<tool> is A1 only."
        },
        "run_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "produced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "identity", "at", "scope"],
      "properties": {
        "by": {
          "type": "string",
          "enum": ["human", "ci"]
        },
        "identity": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "humanSpotCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "at", "source", "ref"],
      "properties": {
        "by": { "type": "string", "pattern": "^human:" },
        "identity": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["github-review", "dsh-approval", "manual"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "reviewSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "assessment_sha256", "package_sha256", "rounds", "new_findings", "dissent", "verdict"],
      "properties": {
        "mode": { "type": "string", "enum": ["light", "standard", "full"] },
        "assessment_sha256": { "$ref": "#/$defs/sha256" },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "rounds": { "type": "integer", "minimum": 1, "maximum": 3 },
        "new_findings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "dissent": { "type": "integer", "minimum": 0 },
        "verdict": { "type": "string", "enum": ["ready", "not-ready"] },
        "zero_dissent_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "human_spot_check": { "$ref": "#/$defs/humanSpotCheck" }
      }
    },
    "correctnessCaseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "claims",
        "mapped_claims",
        "unaccepted_residuals"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "claims": { "type": "integer", "minimum": 1 },
        "mapped_claims": { "type": "integer", "minimum": 1 },
        "unaccepted_residuals": { "type": "integer", "const": 0 }
      }
    },
    "correctnessCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "claims", "invariants", "mapping", "residual"],
      "properties": {
        "schema": {
          "const": "firetree.correctness-case/v1"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claim" }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/invariant" }
        },
        "mapping": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mapping" }
        },
        "residual": {
          "type": "array",
          "items": { "$ref": "#/$defs/residual" }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "kind", "owner"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "statement": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["functional", "safety", "security", "performance", "compatibility"]
        },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "enforced_by", "evidence_ref"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "statement": { "type": "string", "minLength": 1 },
        "enforced_by": {
          "type": "string",
          "enum": ["code", "test", "config", "contract"]
        },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "invariant_ids", "tests", "evidence_refs"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "reason", "accepted_by", "expires_at"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "accepted_by": {
          "type": "string",
          "pattern": "^human:",
          "description": "A human accepts the residual risk; an agent cannot."
        },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
