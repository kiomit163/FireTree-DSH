{
  "name": "@local/firetree-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable delivery protocol for DSH: risk tiers, external evidence receipts, human sign-off, and correctness cases.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "bin/**/*.mjs",
    "index.js",
    "src/**/*.js",
    "skills/**/SKILL.md",
    "schemas/*.schema.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "bin": {
    "firetree-assess": "./bin/firetree-assess.mjs",
    "firetree-check": "./bin/firetree-check.mjs"
  },
  "scripts": {
    "test": "node --test",
    "check:docs": "node scripts/check-docs.mjs",
    "lint:schemas": "node scripts/lint-schemas.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "metrics": "node scripts/metrics.mjs",
    "check": "npm test && npm run check:docs && npm run lint:schemas && npm run check:syntax"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  }
}
